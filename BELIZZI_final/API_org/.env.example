# Copia este archivo a .env (NO subas .env al repositorio).
# docker compose lo lee automáticamente; si no existe, usa valores por defecto.

# Contraseña del usuario SA de SQL Server (mín. 8 caracteres, mayúsculas, minúsculas, números y símbolo)
SQL_PASSWORD=MiClaveSQL2026!

# Secreto con el que se firman y verifican los JWT (el mismo en auth, productos y notificaciones)
JWT_SECRET=cambia-este-secreto-en-produccion
